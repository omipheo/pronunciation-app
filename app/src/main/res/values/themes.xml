<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PronunciationApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">
            ?attr/isLightTheme
        </item>
    </style>

    <!-- The letter glyph in Section 1: large, centred, and the reason the grid reads at a glance. -->
    <style name="TextAppearance.Letter.Glyph" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Ipa" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">monospace</item>
    </style>

</resources>
